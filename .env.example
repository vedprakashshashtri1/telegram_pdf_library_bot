# First bot. After first startup, additional bots can be added with /add_bot.
BOT_TOKEN=123456789:REPLACE_ME

MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=telegram_pdf_library

# Bootstrap owners, comma-separated. Used only when the owners collection is empty.
OWNER_IDS=123456789,987654321

# Shared PDF source channel.
SOURCE_CHANNEL_ID=-1001234567890

# Public Vercel site opened from Telegram's bot menu.
WEBSITE_URL=https://your-site.vercel.app

# Long random secret used to encrypt bot tokens stored in MongoDB.
# KEEP THIS STABLE. Changing it prevents stored tokens from being decrypted.
APP_SECRET=replace-with-a-long-random-secret

APP_TIMEZONE=Asia/Kolkata
DELETE_AFTER_SECONDS=300
DEFAULT_FREE_LIMIT=5
DEFAULT_REFER_RATE=2

# Super Indexer only (local Windows/Linux)
TG_API_ID=123456
TG_API_HASH=replace_me
TG_SESSION=super_indexer
